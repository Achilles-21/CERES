# Copy to .env; set credentials locally. Never commit .env.
CERES_JAVA_PORT=18081
CERES_DB_URL='jdbc:mysql://localhost:3306/ceres?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC'
CERES_DB_USER=
CERES_DB_PASSWORD=
CERES_REDIS_HOST=localhost
CERES_REDIS_PORT=6379
CERES_REDIS_DATABASE=0
CERES_REDIS_PASSWORD=
CERES_JWT_SECRET=
CERES_MINIO_ENDPOINT=http://localhost:10008
CERES_MINIO_PUBLIC_ENDPOINT=http://localhost:10008
CERES_MINIO_ACCESS_KEY=
CERES_MINIO_SECRET_KEY=
CERES_MINIO_BUCKET=ceres
CERES_VOD_SECRET_ID=
CERES_VOD_SECRET_KEY=
CERES_VOD_REGION=ap-shanghai
CERES_VOD_APP_ID=
CERES_MODEL_URL=http://localhost:8000

# Copy to .env; set your own credentials. Blank credentials are intentional.
CERES_BACKEND_MODEL=path/to/ceres/model
CERES_LLM_BASE_URL=http://127.0.0.1:8002/v1
CERES_MEDRAG_URL=http://localhost:8001
# Empty CERES_DATA_DIR means the default backend-model/LocalData directory.
# Set an absolute data directory when enabling the model service.
XUNFEI_ASR_APP_ID=
XUNFEI_ASR_API_KEY=
XUNFEI_ASR_API_SECRET=

XUNFEI_APP_ID=
XUNFEI_API_SECRET=
# Slide generation runtime settings; shared with backend-model/.env.
CERES_SLIDEGEN_PORT=8081
CERES_SLIDE_CACHE_DIR=
