<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ceres.system.mapper.VideoPopMapper">

    <insert id="saveBatchList" parameterType="java.util.List">
        insert into video_pop
            (video_id, que_id, question_time)
        values
        <foreach item="videoPop" index="index" collection="videoPopList" separator=",">
            (#{videoPop.videoId}, #{videoPop.queId}, #{videoPop.questionTime})
        </foreach>
    </insert>

</mapper>
