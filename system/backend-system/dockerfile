FROM maven:3.9-eclipse-temurin-11 AS build
WORKDIR /build
COPY . .
RUN mvn -B package -DskipTests

FROM eclipse-temurin:11-jre
WORKDIR /app
COPY --from=build /build/ceres-admin/target/ceres-admin.jar /app/ceres-admin.jar
EXPOSE 8080
ENTRYPOINT ["java", "-Xms128m", "-Xmx256m", "-jar", "/app/ceres-admin.jar"]
