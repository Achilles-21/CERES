# Copy to .env; set your own credentials. Blank credentials are intentional.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Generation model shared by teaching, MedRAG and slide generation.
# This must match the model identifier exposed by your inference server.
CERES_BACKEND_MODEL=path/to/ceres/model
CERES_LLM_BASE_URL=http://127.0.0.1:8002/v1
CERES_MODEL_URL=http://localhost:8000
CERES_MEDRAG_URL=http://localhost:8001
# Empty CERES_DATA_DIR means the default backend-model/LocalData directory.
# Set an absolute data directory when enabling the model service.
XUNFEI_ASR_APP_ID=
XUNFEI_ASR_API_KEY=
XUNFEI_ASR_API_SECRET=
# Shared model and slide service launch settings.
CERES_HOST=127.0.0.1
CERES_MODEL_PORT=8000
CERES_SLIDEGEN_PORT=8081
# Empty uses backend-model/SlideCache; relative paths resolve from backend-model.
CERES_SLIDE_CACHE_DIR=
# Xunfei AIPPT credentials, required for PPT export.
XUNFEI_APP_ID=
XUNFEI_API_SECRET=
